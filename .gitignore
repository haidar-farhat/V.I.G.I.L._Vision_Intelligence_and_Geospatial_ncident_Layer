# build output
dist/
build/
out/

# runtime data - never commit operational data or evidence
data/
var/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# local model + map binaries (imported by the operator, never committed)
models/*
!models/.gitkeep
!models/README.md
map-data/*
!map-data/.gitkeep
!map-data/README.md

# secrets - MUST never be committed
.env
.env.*
!.env.example
*.pem
*.key
!**/testdata/*.key
secrets/

# logs
logs/
*.log
npm-debug.log*

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# desktop build output
apps/desktop/dist/

# Rust build output
# Any Rust build directory, at any depth. The unanchored form matters: a
# pattern with a slash in it is anchored to this file's directory, so
# `core/target/` matched the v1 core and silently did not match `v2/core/target`
# — which is how 22 MB of compiled output reached a commit.
**/target/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# Benchmark scratch (regenerated by engine/tests/bench_scaling.py)
engine/tests/.bench/
build/
dist/
*.spec.bak
media/*
!media/README.md
evidence/*
!evidence/README.md
dist/screenshots/

# The double-clickable application, built by `python v2/tasks.py app` into the
# repository root so it is the first thing in the folder. `_internal` is the
# 340 MiB PyInstaller tree that has to sit beside the executable; both are
# build output and neither belongs in history — 22 MiB of `core/target` once
# reached a commit through an anchored pattern that missed a subdirectory.
/VIGIL.exe
/_internal/
/vigil_core.dll
/build.json
