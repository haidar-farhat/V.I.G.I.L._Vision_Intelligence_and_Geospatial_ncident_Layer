# build output
dist/
build/
out/

# runtime data - never commit operational data or evidence
data/
var/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# local model + map binaries (imported by the operator, never committed)
models/*
!models/.gitkeep
!models/README.md
map-data/*
!map-data/.gitkeep
!map-data/README.md

# secrets - MUST never be committed
.env
.env.*
!.env.example
*.pem
*.key
!**/testdata/*.key
secrets/

# logs
logs/
*.log
npm-debug.log*

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# desktop build output
apps/desktop/dist/

# Rust build output
core/target/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# Benchmark scratch (regenerated by engine/tests/bench_scaling.py)
engine/tests/.bench/
