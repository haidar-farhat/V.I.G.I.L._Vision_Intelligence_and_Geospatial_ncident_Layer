{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Sentinel Vision",
  "version": "0.1.0",
  "identifier": "com.sentinelvision.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5183",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Sentinel Vision",
        "width": 1680,
        "height": 1000,
        "minWidth": 1280,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:* http://127.0.0.1:*",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$APPLOCALDATA/**"]
      }
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "tooltip": "Sentinel Vision"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "deb", "rpm", "appimage", "dmg"],
    "icon": ["icons/icon.png"],
    "copyright": "Copyright (c) 2024 Haydar Farhat",
    "category": "Utility",
    "shortDescription": "Local-first AI multi-camera security platform",
    "longDescription": "Sentinel Vision turns ordinary IP cameras into a local event intelligence system. Runs entirely offline."
  },
  "plugins": {}
}
