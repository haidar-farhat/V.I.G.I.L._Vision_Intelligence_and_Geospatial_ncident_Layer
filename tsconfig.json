{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "services/*/src/**/*.ts",
    "services/*/test/**/*.ts",
    "simulator/src/**/*.ts",
    "simulator/test/**/*.ts",
    "scripts/**/*.mjs"
  ],
  "exclude": ["node_modules", "**/node_modules", "dist", "**/dist", "apps/desktop"]
}
