# Sentinel Vision - example configuration.
# Copy to .env and edit. NEVER commit a real .env.
#
# Camera and node credentials are NOT configured here and never will be. They
# belong in the operating system's keychain, and that is not built yet - today
# no secret is persisted anywhere at all. See docs/SECURITY.md.
#
# BE AWARE: almost nothing in this file is read yet. The variables below are
# grouped by whether they do anything today, because a configuration file that
# advertises settings nothing honours is worse than one that is empty - somebody
# sets SENTINEL_ENFORCE_OFFLINE=true, believes they have a guarantee, and has
# nothing. See STATUS.md.

# =============================================================== READ TODAY ===

# Where to find the Rust engine core. Leave unset and it is looked up next to
# the Python package, then in core/target/release, then core/target/debug -
# which is what a developer who has just run `cargo build` wants.
SENTINEL_CORE_LIB=

# The egress guard's one override. Leave unset. Set to 1 only for a camera on
# a routed private WAN; every start and every connection it allows is logged
# at WARNING with the address. Never for the Internet.
SENTINEL_ALLOW_PUBLIC_SOURCES=

# Where the log, the database, evidence and recordings go (read today; see the
# data-layout section below for the rest).
SENTINEL_DATA_DIR=

# ============================================== NOT READ YET - RESERVED ONLY ===
# Every variable below this line is part of the design in ARCHITECTURE.md and is
# currently ignored by all code. Setting one has no effect.

# ---------------------------------------------------------------- node identity
SENTINEL_NODE_NAME=control-01
# CONTROL | WORKER | STORAGE | HYBRID
SENTINEL_NODE_ROLE=HYBRID

# ------------------------------------------------------------------ data layout
# Leave unset to use the per-OS application data directory.
SENTINEL_DATA_DIR=
SENTINEL_DB_URL=sqlite://./data/sentinel.db
SENTINEL_LOG_LEVEL=info

# ---------------------------------------------------------------------- network
# Bind to a LAN interface. 0.0.0.0 is allowed but discouraged on multi-homed hosts.
SENTINEL_API_HOST=127.0.0.1
SENTINEL_API_PORT=8787
# Discovery over mDNS/DNS-SD on the local link only.
SENTINEL_DISCOVERY_ENABLED=true

# ------------------------------------------------------------- offline enforcement
# Intended as a hard guarantee: the runtime refuses non-private-range egress.
# Until the egress guard exists, the zero-WAN property rests on the code making
# no outbound calls at all, and on the CI job that blocks the network and proves
# the block took effect before running the suites.
SENTINEL_ENFORCE_OFFLINE=true
SENTINEL_TELEMETRY=disabled

# -------------------------------------------------------------------------- AI
# Local inference only. A model is supplied by the operator and placed in
# models/. Nothing is ever downloaded.
SENTINEL_MODEL_PATH=
SENTINEL_INFERENCE_DEVICE=auto
SENTINEL_LLM_ENDPOINT=
SENTINEL_LLM_MODEL=
