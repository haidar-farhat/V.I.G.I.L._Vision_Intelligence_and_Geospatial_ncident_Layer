# Sentinel Vision - example configuration.
# Copy to .env and edit. NEVER commit a real .env.
# Camera and node credentials are NOT configured here; they live in the OS
# keychain (see packages/security). This file holds non-secret deployment config.

# ---------------------------------------------------------------- node identity
SENTINEL_NODE_NAME=control-01
# CONTROL | WORKER | STORAGE | HYBRID
SENTINEL_NODE_ROLE=HYBRID

# ------------------------------------------------------------------ data layout
# Leave unset to use the per-OS application data directory.
SENTINEL_DATA_DIR=
SENTINEL_DB_URL=sqlite://./data/sentinel.db
SENTINEL_LOG_LEVEL=info

# ---------------------------------------------------------------------- network
# Bind to a LAN interface. 0.0.0.0 is allowed but discouraged on multi-homed hosts.
SENTINEL_API_HOST=127.0.0.1
SENTINEL_API_PORT=8787
# Discovery over mDNS/DNS-SD on the local link only.
SENTINEL_DISCOVERY_ENABLED=true

# ------------------------------------------------------------- offline enforcement
# Hard guarantee: the runtime refuses non-private-range egress when true.
SENTINEL_ENFORCE_OFFLINE=true
SENTINEL_TELEMETRY=disabled

# -------------------------------------------------------------------------- AI
# Local inference only. Empty endpoint disables the AI analyst.
SENTINEL_LLM_ENDPOINT=
SENTINEL_LLM_MODEL=
SENTINEL_INFERENCE_DEVICE=auto
